---
import BaseLayout from './Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { ArrowLeft, Calendar, User, Tag } from 'lucide-react';

interface Props {
  title: string;
  description: string;
  date?: Date | string;
  author?: string;
  category?: string;
  tags?: string[];
  canonicalUrl?: string;
  ogImage?: string;
}

const {
  title,
  description,
  date,
  author = 'urBackend Team',
  category,
  tags = [],
  canonicalUrl,
  ogImage,
} = Astro.props;

const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;

const blogStructuredData = date
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      author: {
        '@type': 'Organization',
        name: author,
      },
      datePublished: new Date(date).toISOString(),
    }
  : undefined;
---

<BaseLayout
  title={`${title} | urBackend Blog`}
  description={description}
  keywords={tags.length ? tags.join(', ') : undefined}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  structuredData={blogStructuredData}
>
  <Navbar />

  <main class="content-page-main">
    <div class="content-page-container">
      <div class="content-nav-back">
        <a href="/blog" class="back-link">
          <ArrowLeft size={16} />
          <span>Back to all articles</span>
        </a>
      </div>

      <header class="content-header">
        {category && <span class="content-category">{category}</span>}
        <h1 class="content-title">{title}</h1>
        <p class="content-lead">{description}</p>

        <div class="content-meta">
          <div class="meta-item">
            <User size={15} />
            <span>{author}</span>
          </div>
          {formattedDate && (
            <div class="meta-item">
              <Calendar size={15} />
              <span>{formattedDate}</span>
            </div>
          )}
        </div>
      </header>

      <article class="content-body prose-dark">
        <slot />
      </article>

      {tags.length > 0 && (
        <div class="content-tags">
          <Tag size={14} />
          <div class="tags-list">
            {tags.map((tag) => (
              <span class="tag-pill">{tag}</span>
            ))}
          </div>
        </div>
      )}

      <div class="content-cta-card">
        <div class="cta-inner">
          <h3>Build with urBackend today</h3>
          <p>Instant REST APIs, Auth, and Storage for your MongoDB. Free developer tier.</p>
          <a href="https://app.urbackend.in/signup" class="btn-hero-primary">
            Get Started Free
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style>
  .content-page-main {
    min-height: 100vh;
    padding: calc(var(--nav-height, 70px) + 3rem) 1.5rem 6rem;
    background: #030303;
    color: #fcfcfc;
  }

  .content-page-container {
    max-width: 820px;
    margin: 0 auto;
  }

  .content-nav-back {
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: #a1a1aa;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: #00f5d4;
  }

  .content-header {
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .content-category {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.75rem;
    background: rgba(0, 245, 212, 0.08);
    border: 1px solid rgba(0, 245, 212, 0.2);
    color: #00f5d4;
    margin-bottom: 1.25rem;
  }

  .content-title {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin: 0 0 1.25rem;
    color: #fff;
  }

  .content-lead {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #a1a1aa;
    margin: 0 0 2rem;
  }

  .content-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-size: 0.9rem;
    color: #71717a;
    font-family: 'JetBrains Mono', monospace;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Prose Styling */
  .prose-dark {
    font-size: 1.05rem;
    line-height: 1.8;
    color: #d4d4d8;
  }

  .prose-dark :global(h2) {
    font-size: 1.8rem;
    font-weight: 700;
    color: #fff;
    margin: 3rem 0 1rem;
    letter-spacing: -0.02em;
  }

  .prose-dark :global(h3) {
    font-size: 1.4rem;
    font-weight: 600;
    color: #fff;
    margin: 2rem 0 0.75rem;
  }

  .prose-dark :global(p) {
    margin: 0 0 1.5rem;
  }

  .prose-dark :global(ul),
  .prose-dark :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .prose-dark :global(li) {
    margin-bottom: 0.5rem;
  }

  .prose-dark :global(code) {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9em;
    background: #141414;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.2em 0.4em;
    border-radius: 4px;
    color: #00f5d4;
  }

  .prose-dark :global(pre) {
    background: #0a0a0a !important;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.25rem;
    overflow-x: auto;
    margin: 2rem 0;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .prose-dark :global(pre code) {
    background: transparent;
    border: none;
    padding: 0;
    color: #fff;
  }

  .prose-dark :global(blockquote) {
    border-left: 3px solid #00f5d4;
    padding-left: 1.25rem;
    margin: 2rem 0;
    font-style: italic;
    color: #a1a1aa;
  }

  .prose-dark :global(strong) {
    color: #fff;
    font-weight: 600;
  }

  .prose-dark :global(a) {
    color: #00f5d4;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .prose-dark :global(hr) {
    border: none;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    margin: 3rem 0;
  }

  .content-tags {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 3rem 0;
    padding: 1.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    color: #71717a;
  }

  .tags-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    font-size: 0.78rem;
    padding: 0.2rem 0.6rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #a1a1aa;
  }

  .content-cta-card {
    margin-top: 4rem;
    background: #080808;
    border: 1px solid rgba(0, 245, 212, 0.25);
    padding: 2.5rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .content-cta-card::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(0, 245, 212, 0.08) 0%, transparent 70%);
    filter: blur(80px);
    pointer-events: none;
  }

  .cta-inner {
    position: relative;
    z-index: 1;
  }

  .cta-inner h3 {
    font-size: 1.6rem;
    font-weight: 700;
    color: #fff;
    margin: 0 0 0.5rem;
  }

  .cta-inner p {
    color: #a1a1aa;
    margin: 0 0 1.75rem;
    font-size: 1rem;
  }
</style>
