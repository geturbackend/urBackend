---
interface Props {
  title: string;
  description: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
  structuredData?: Record<string, any>;
  noindex?: boolean;
}
const { title, description, keywords, canonicalUrl, ogImage, structuredData, noindex } = Astro.props;
import '../styles/landing.css';
import Analytics from '@vercel/analytics/astro';

const defaultKeywords = "MongoDB BaaS, Backend as a Service, MongoDB backend, Firebase alternative for MongoDB, Supabase MongoDB, serverless MongoDB API, MongoDB Atlas BaaS, Instant REST API, MERN stack backend";
const metaKeywords = keywords || defaultKeywords;

const defaultStructuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "urBackend",
  "applicationCategory": "DeveloperApplication",
  "description": description,
  "url": "https://urbackend.in",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};
const jsonLd = structuredData || defaultStructuredData;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <Analytics />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon.ico?v=2" />
  <link rel="icon" type="image/png" sizes="192x192" href="/LOGO_SQ.png?v=2" />
  <link rel="apple-touch-icon" href="/LOGO_SQ.png?v=2" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={metaKeywords} />
  <meta name="author" content="urBackend" />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl || Astro.url.href} />
  <meta property="og:image" content={ogImage || '/og-image.png'} />
  <meta property="og:site_name" content="urBackend" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage || '/og-image.png'} />
  
  <!-- Canonical -->
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <meta name="google-site-verification" content="o5KNQ9R-ummCVpBGTiPWtBLvDPdVm-uxMuIQXmj3mlU" />
</head>
<body>
  <slot />
  <script src="https://trustviews.io/script.js" data-token="1eb5486b-658e-4b62-8c87-1d731b7dfc2f"></script>
</body>
</html>
