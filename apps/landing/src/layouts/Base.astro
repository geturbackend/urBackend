---
interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
}
const { title, description, canonicalUrl, ogImage } = Astro.props;
import '../styles/landing.css';
import Analytics from '@vercel/analytics/astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <Analytics />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" href="/LOGO_SQ.png" />
  <link rel="apple-touch-icon" href="/LOGO_SQ.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage || '/og-image.png'} />
  <meta property="og:site_name" content="urBackend" />
  
  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage || '/og-image.png'} />
  
  <!-- Canonical -->
  {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "urBackend",
      "applicationCategory": "DeveloperApplication",
      "description": description,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
    })}>
  </script>
  
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet" />
  <meta name="google-site-verification" content="o5KNQ9R-ummCVpBGTiPWtBLvDPdVm-uxMuIQXmj3mlU" />
</head>
<body>
  <slot />
  <script src="https://trustviews.io/script.js" data-token="1eb5486b-658e-4b62-8c87-1d731b7dfc2f"></script>
</body>
</html>
