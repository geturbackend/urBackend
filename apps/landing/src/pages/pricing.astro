---
import BaseLayout from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { Check, ChevronDown, HelpCircle, ArrowRight } from 'lucide-react';

const FREE_FEATURES = [
  '1 Project, 5 Collections',
  '2,000 API requests / day',
  '200 Auth Users',
  '3 Active Webhooks',
  '50 Emails / month (Sends & Broadcasts)',
  'Custom HTML Email Templates',
  'Bring Your Own MongoDB (BYOM)',
  'Bring Your Own Storage (S3 / R2)',
  'Bring Your Own Keys (Resend, OAuth, AI)',
  'Team Collaboration (up to 2 members)',
  'Analytics Pro & Deep Insights',
  'Community support',
];

const PRO_FEATURES = [
  '10 Projects, Unlimited Collections',
  'Unlimited API requests (600 req/min burst)',
  'Unlimited Auth Users',
  'Unlimited Webhooks + Priority Delivery',
  '1,000 Emails / month',
  'Up to 6 Team Members',
  'Priority support',
];

const PRICING_FAQS = [
  {
    q: 'What happens when I exceed free tier limits?',
    a: 'API requests are gracefully rate-limited with HTTP 429 rather than resulting in unexpected charges. You will never receive a surprise bill.'
  },
  {
    q: 'Can I bring my own MongoDB Atlas cluster on the Free tier?',
    a: 'Yes! Both Free and Pro tiers support Bring Your Own MongoDB (BYOM) and Bring Your Own Storage (BYOS). Connect your Atlas cluster or S3 bucket directly on any plan.'
  },
  {
    q: 'How does the free 1-month Pro trial work?',
    a: 'Click "Get 1 month Pro for free" to unlock Pro features on your account with zero credit card required.'
  },
  {
    q: 'Do you offer team collaboration?',
    a: 'Yes. Free plans allow up to 2 team members (owner + 1 collaborator). Pro plans support up to 6 members with role-based access control.'
  }
];
---

<BaseLayout 
  title="urBackend Pricing - Free Developer Tier & Predictable Scale for MongoDB" 
  description="Affordable, transparent MongoDB BaaS pricing. Get started free with 1 project, 10MB storage, and 2,000 daily API requests. Upgrade to Pro for BYOM and dedicated scale."
  keywords="MongoDB pricing, Backend as a Service pricing, free MongoDB backend, BaaS cost comparison, Firebase alternative pricing, Supabase pricing alternative, serverless backend pricing"
  canonicalUrl="https://urbackend.in/pricing"
>
  <div class="pricing-page">
    <Navbar />

    <main class="pricing-main">
      <div class="pricing-hero">
        <span class="section-badge" style="display: inline-block; margin-bottom: 1rem;">PLANS & LIMITS</span>
        <h1>Simple pricing for every stage</h1>
        <p>No unexpected bills. Start building on the free tier, scale as your application grows.</p>
      </div>

      <div class="pricing-grid">
        <section class="pricing-card">
          <div class="pricing-badge">Free</div>
          <h2>Developer Beta</h2>
          <div class="pricing-price">
            <span class="pricing-amount">$0</span>
            <span class="pricing-term">/mo</span>
          </div>
          <p class="pricing-subtext">Perfect for side projects, MVPs, and learning.</p>
          <ul class="pricing-list">
            {FREE_FEATURES.map((feature) => (
              <li>
                <Check size={16} />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <a href="https://app.urbackend.in/signup" class="pricing-button">
            Start for Free
          </a>
        </section>

        <section class="pricing-card pricing-card-highlight">
          <div class="pricing-badge">Pro (Beta)</div>
          <h2>Pro</h2>
          <div class="pricing-price">
            <span class="pricing-amount pricing-amount-strike">$9</span>
            <span class="pricing-term">/mo</span>
          </div>
          <p class="pricing-subtext pricing-free-trial">Try now free for a month</p>
          <ul class="pricing-list">
            {PRO_FEATURES.map((feature) => (
              <li>
                <Check size={16} />
                <span>{feature}</span>
              </li>
            ))}
          </ul>
          <a href="https://app.urbackend.in/request-pro" class="pricing-button pricing-button-green">
            Get 1 month Pro for free
          </a>
        </section>
      </div>

      <!-- Pricing FAQ Section -->
      <section class="pricing-faq-section">
        <div class="faq-heading-box">
          <HelpCircle size={24} color="#00f5d4" />
          <h2>Frequently Asked Questions</h2>
        </div>
        <div class="pricing-faq-grid">
          {PRICING_FAQS.map((faq) => (
            <div class="p-faq-card">
              <h3>{faq.q}</h3>
              <p>{faq.a}</p>
            </div>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  .pricing-faq-section {
    margin-top: 6rem;
    padding-top: 4rem;
    border-top: 1px solid #1f1f1f;
  }

  .faq-heading-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-bottom: 3rem;
  }

  .faq-heading-box h2 {
    font-size: 1.8rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }

  .pricing-faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
  }

  .p-faq-card {
    background: #080808;
    border: 1px solid #1a1a1a;
    padding: 2rem;
  }

  .p-faq-card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: #fff;
    margin: 0 0 0.75rem;
  }

  .p-faq-card p {
    font-size: 0.95rem;
    color: #a1a1aa;
    line-height: 1.6;
    margin: 0;
  }
</style>
