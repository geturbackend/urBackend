{
  "name": "urbackend-monorepo",
  "version": "0.10.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*",
    "sdks/*"
  ],
  "scripts": {
    "dev": "concurrently -c \"cyan,magenta,yellow,green\" -n \"DASHBOARD,PUBLIC,WEB,CONSUMER\" \"npm run dev --workspace=dashboard-api\" \"npm run dev --workspace=public-api\" \"npm run dev --workspace=web-dashboard\" \"npm run dev --workspace=consumer\"",
    "build": "npm run build --workspaces --if-present",
    "test:web-client": "npm run test --workspace=web-client",
    "loadtest:public": "node scripts/loadtest-public-api.js",
    "loadtest:dashboard": "node scripts/loadtest-dashboard-api.js",
    "prepare": "husky || node -e \"\""
  },
  "lint-staged": {
    "apps/web-dashboard/**/*.{js,jsx}": [
      "npm exec --workspace=web-dashboard eslint"
    ]
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "concurrently": "9.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.0.5"
  },
  "dependencies": {
    "@aws-sdk/lib-storage": "3.1053.0",
    "path": "0.12.7"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  }
}
